# Copy to .env.local and fill in from your Auth0 dashboard (see ../README.md).
# Vite only exposes variables prefixed with VITE_ to the browser. Everything here is public by
# design -- a SPA is a public client and holds no secrets. There is deliberately no client secret.

VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id

# Must equal the Auth0 API "Identifier". Without this the SDK returns an opaque session token
# instead of a JWT for your API, and the backend will reject it.
VITE_AUTH0_AUDIENCE=https://teamboard-api

VITE_API_BASE=http://localhost:8080

VITE_ORG_ACME=org_YOUR_ACME_ID
VITE_ORG_GLOBEX=org_YOUR_GLOBEX_ID
